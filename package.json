                     "deepseek-harness",
                     "theme"
                 ],
    "author":  "Xiaoli-Asuna",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Xiaoli-Asuna/dsh-theme-endfield-style.git"
                   },
    "homepage":  "https://github.com/Xiaoli-Asuna/dsh-theme-endfield-style#readme",
    "bugs":  {
                 "url":  "https://github.com/Xiaoli-Asuna/dsh-theme-endfield-style/issues"
             },
    "dsh":  {
