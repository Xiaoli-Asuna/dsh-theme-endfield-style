                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                          ]
                           }
            },
    "scripts":  {
                    "build":  "node build.mjs"
                },
    "devDependencies":  {
                            "esbuild":  "^0.25.0"
                        }
}
